<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{% for item in site.pages %}{% if item.url contains '.html' or item.url contains '/blog/' or item.url == '/' or item.layout %}{% unless item.url contains 'assets/' or item.url contains 'search.json' %}<url><loc>{{ item.url | absolute_url | xml_escape }}</loc></url>{% endunless %}{% endif %}{% endfor %}
{% for item in site.documents %}<url><loc>{{ item.url | absolute_url | xml_escape }}</loc></url>{% endfor %}
</urlset>
